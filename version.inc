# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# The product name is defined once, in src/common_func/common_func.hpp. Read it back out
# of that header rather than repeating it here - the two used to be edited separately and
# drifted. A missing or renamed #define is a hard configure error, not a silent empty name.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/src/common_func/common_func.hpp" _brand_defines
     REGEX "^#define[ \t]+SLIC3R_APP_(NAME|KEY)[ \t]+\"")
foreach(_brand_line IN LISTS _brand_defines)
    if(_brand_line MATCHES "^#define[ \t]+SLIC3R_APP_NAME[ \t]+\"([^\"]+)\"")
        set(SLIC3R_APP_NAME "${CMAKE_MATCH_1}")
    elseif(_brand_line MATCHES "^#define[ \t]+SLIC3R_APP_KEY[ \t]+\"([^\"]+)\"")
        set(SLIC3R_APP_KEY "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(NOT SLIC3R_APP_NAME OR NOT SLIC3R_APP_KEY)
    message(FATAL_ERROR "version.inc: could not read SLIC3R_APP_NAME/SLIC3R_APP_KEY from src/common_func/common_func.hpp")
endif()

if(NOT DEFINED BBL_RELEASE_TO_PUBLIC)
set(BBL_RELEASE_TO_PUBLIC "1")
endif()
if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
set(Snapmaker_VERSION "2.3.6.4")
set(MIN_FIRM_VER "1.0.0")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       Snapmaker_VERSION_MATCH ${Snapmaker_VERSION})
set(ORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(ORCA_VERSION_PATCH ${CMAKE_MATCH_3})

set(SLIC3R_VERSION "01.10.01.50")

if (NOT DEFINED ORCA_UPDATER_SIG_KEY)
    set(ORCA_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
