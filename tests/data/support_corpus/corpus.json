{
  "_comment": [
    "Corpus for scripts/support_group_identity.py - the off-mode byte-identity gate of",
    "docs/superpowers/plans/2026-09-02-support-sets-and-groups.md §3.7.",
    "",
    "Every entry names models already in this repository (resources/handy_models/, plus the two",
    "tiny multi-part fixtures made by make_fixtures.py), so the corpus adds no bulky binary data.",
    "The support configuration travels as CLI overrides rather than baked into project files:",
    "the slicer's CLI accepts any print_config_def key as --key=value, which keeps every case",
    "readable and lets a reviewer see exactly what is being pinned.",
    "",
    "Paths are relative to the repository root. 'args' are passed verbatim after the presets."
  ],
  "presets": {
    "printer": "Snapmaker U1 (0.4 nozzle)",
    "process": "0.20 Standard @Snapmaker U1 (0.4 nozzle)",
    "filaments": ["Generic PLA"]
  },
  "cases": [
    {
      "name": "normal_single",
      "models": ["resources/handy_models/ksr_fdmtest_v4.3mf"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--support-style=grid"]
    },
    {
      "name": "normal_multipart",
      "models": ["tests/data/support_corpus/twopart_bridge.3mf"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--support-style=grid"]
    },
    {
      "name": "normal_ledge",
      "models": ["tests/data/support_corpus/overhang_ledge.3mf"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--support-style=snug"]
    },
    {
      "name": "soluble_interface",
      "models": ["tests/data/support_corpus/twopart_bridge.3mf"],
      "filaments": ["Generic PLA", "Generic PVA"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--support-style=grid",
               "--support-top-z-distance=0", "--support-interface-filament=2",
               "--support-interface-top-layers=3", "--support-interface-spacing=0"]
    },
    {
      "name": "tree_organic",
      "models": ["resources/handy_models/ksr_fdmtest_v4.3mf"],
      "args": ["--enable-support=1", "--support-type=tree(auto)", "--support-style=organic"]
    },
    {
      "name": "tree_classic",
      "models": ["resources/handy_models/ksr_fdmtest_v4.3mf"],
      "args": ["--enable-support=1", "--support-type=tree(auto)", "--support-style=tree_slim"]
    },
    {
      "name": "raft",
      "models": ["tests/data/support_corpus/twopart_bridge.3mf"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--raft-layers=4"]
    },
    {
      "name": "multi_object",
      "models": ["tests/data/support_corpus/twopart_bridge.3mf",
                 "tests/data/support_corpus/overhang_ledge.3mf"],
      "args": ["--enable-support=1", "--support-type=normal(auto)", "--support-style=grid"]
    },
    {
      "name": "no_support",
      "models": ["resources/handy_models/Voron_Design_Cube_v7.3mf"],
      "args": ["--enable-support=0"]
    }
  ]
}
